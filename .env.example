APP_NAME="BioLearn"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite lokal: path default adalah database/database.sqlite (dibuat composer setup).
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/biology-learn/database/database.sqlite

# Alternatif MySQL: ganti DB_CONNECTION dan aktifkan lima baris berikut.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=biology_learn
# DB_USERNAME=biology_learn
# DB_PASSWORD=replace-with-your-local-password

# Alternatif Neon PostgreSQL: DB_CONNECTION=pgsql, lalu aktifkan opsi berikut.
# DB_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# DB_POOLED=true
# DB_DIRECT_HOST=HOST.REGION.aws.neon.tech
# DB_SSLMODE=require
# DB_CHANNEL_BINDING=require
# DB_CONNECT_TIMEOUT=15
# DB_DIRECT_HOST memakai hostname yang sama tanpa akhiran -pooler.
# Hapus DB_HOST/PORT/DATABASE/USERNAME/PASSWORD lama ketika memakai DB_URL.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Aktifkan hanya pada server HTTPS.
# SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@biologylearn.id"
MAIL_FROM_NAME="${APP_NAME}"

# Untuk SMTP, ubah MAIL_MAILER=smtp dan sesuaikan host/port/kredensial di atas.
# MAIL_SCHEME=smtps untuk koneksi TLS langsung (umumnya port 465).

# Opsional. Login email dan akun demo tidak memerlukan Google OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

VITE_APP_NAME="${APP_NAME}"
